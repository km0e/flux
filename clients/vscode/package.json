{
  "name": "flux-vscode",
  "displayName": "Flux Agent",
  "description": "VSCode frontend for the Flux agent framework",
  "version": "0.1.0",
  "publisher": "flux",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/example/flux"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "flux.openChat",
        "title": "Open Flux Chat",
        "category": "Flux",
        "icon": "media/chat.svg"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "flux.openChat",
          "group": "navigation",
          "when": "true"
        }
      ]
    },
    "configuration": {
      "title": "Flux",
      "properties": {
        "flux.serverMode": {
          "type": "string",
          "enum": [
            "stdio",
            "tcp"
          ],
          "default": "stdio",
          "description": "How to connect to flux-server. 'stdio' spawns a local binary; 'tcp' connects to a running server."
        },
        "flux.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the flux-server binary. If empty, the extension will try to use the workspace target/release build. Only used when serverMode is stdio."
        },
        "flux.serverHost": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Host to connect to when serverMode is tcp."
        },
        "flux.serverPort": {
          "type": "number",
          "default": 8080,
          "description": "Port to connect to when serverMode is tcp."
        },
        "flux.mcpServers": {
          "type": "array",
          "default": [],
          "description": "List of MCP servers to launch. Each entry needs {command, args?, env?}.",
          "items": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object"
              }
            },
            "required": [
              "command"
            ]
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "precompile": "node -e \"require('fs').cpSync('node_modules/marked/lib/marked.umd.js','media/marked.umd.js'); require('fs').cpSync('node_modules/dompurify/dist/purify.min.js','media/purify.min.js');\"",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "dompurify": "^3.4.11",
    "marked": "^18.0.5"
  }
}
