{
  "name": "@flux/web",
  "version": "0.2.0",
  "private": true,
  "description": "Flux web UI — the single frontend (served by flux-server's static layer). React 19 + Radix UI + Tailwind v4 + zustand on Vite.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:fast": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "ui-check": "node e2e/ui-check.mjs",
    "shots": "node e2e/shots.mjs",
    "gen:proto": "cd ../.. && buf generate proto --template buf.gen.yaml",
    "prebuild": "npm run gen:proto",
    "pretest": "npm run gen:proto",
    "proto:check": "cd ../.. && buf lint proto && buf breaking proto --against .git#ref=origin/main,subdir=proto && buf generate proto"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.1",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-web": "^2.2.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.13",
    "highlight.js": "^11.12.0",
    "lucide-react": "^0.545.0",
    "marked": "^18.0.9",
    "react": "^19.2.1",
    "react-arborist": "^3.4.3",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.14.1",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.1.10"
  }
}
